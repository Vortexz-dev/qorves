    ]
  },
  "validation_order": [
    {
      "order": 1,
      "code": "TIER_MISMATCH",
      "rule_tr": "Dorse boyutu şasinin kabul ettiği boyutlardan biri",
      "message_example_tr": "Bu dorse T2 boyutunda. Outrider şasi yalnız T1 dorse çeker."
    },
    {
      "order": 2,
      "code": "TRAILER_LIMIT",
      "rule_tr": "Dorse sayısı şasi sınırının altında",
      "message_example_tr": "Dorse sınırı dolu (1 / 1). Daha fazlası için Longhaul şasi gerekir."
    },
    {
      "order": 3,
      "code": "ENGINE_LIMIT",
      "rule_tr": "Motor adedi ve boyutu şasi kuralına uyuyor",
      "message_example_tr": "S2 motor için en az Longhaul şasi gerekir."
    },
    {
      "order": 4,
      "code": "CORE_LIMIT",
      "rule_tr": "Çekirdek adedi ve boyutu şasi kuralına uyuyor",
      "message_example_tr": "İkinci çekirdek için en az Longhaul şasi gerekir."
    },
    {
      "order": 5,
      "code": "MIXED_POWER",
      "rule_tr": "Gemide yalnız tek güç teknolojisi var",
      "message_example_tr": "Skarn Çekirdeği ve insan reaktörü birlikte takılamaz (yalnız DM istisnası)."
    },
    {
      "order": 6,
      "code": "NO_FREE_SLOT",
      "rule_tr": "Uygun boyut ve yerde boş yuva var",
      "message_example_tr": "Boş S2 yuvası yok. Bu parça S2 ya da daha büyük bir yuva ister."
    },
    {
      "order": 7,
      "code": "WRONG_MOUNT",
      "rule_tr": "Parça yuvanın yerine uygun (Dış / İç)",
      "message_example_tr": "Silahlar yalnız Dış yuvaya takılır."
    },
    {
      "order": 8,
      "code": "REQUIREMENT_MISSING",
      "rule_tr": "Parçanın gereksinimi karşılanıyor",
      "message_example_tr": "Öneri: Mirror Maze için EW dorsesi ya da netrunner istasyonu gerekir."
    },
    {
      "order": 9,
      "code": "CAPACITY_FULL",
      "rule_tr": "Yük hedef ambara sığıyor",
      "message_example_tr": "Dorse ambarı dolu (80 / 80 t)."
    },
    {
      "order": 10,
      "code": "MASS_LIMIT",
      "rule_tr": "Yeni Mass ≤ Max Mass",
      "message_example_tr": "Takılamaz: Max Mass 3 t aşılıyor (203 / 200 t)."
    },
    {
      "order": 11,
      "code": "THRUST_TOO_LOW",
      "rule_tr": "Sökülen motor ya da itici sonrası Mass ≤ Max Mass",
      "message_example_tr": "Bu itici sökülürse Max Mass aşılır (203 / 200 t). Önce yük boşaltın."
    },
    {
      "order": 12,
      "code": "POWER_LIMIT",
      "rule_tr": "Yeni Power Draw ≤ Power Output",
      "message_example_tr": "Takılamaz: Power 12 aşılıyor (112 / 100)."
    }
  ],
