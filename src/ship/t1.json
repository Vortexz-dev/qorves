{
  "version": "0.2-beta",
  "status": "beta / ayarlanacak — tüm sayılar yer tutucu",
  "scope": "T1 Outrider (site ilk aşama)",
  "units": {
    "mass": "t",
    "thrust": "t (1 Thrust = 1 t taşınabilir kütle)",
    "power": "birimsiz",
    "mobility": "0-100",
