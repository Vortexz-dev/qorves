      "Yardımcı": "eklentinin mount alanına göre"
    }
  },
  "formulas": {
    "mass": "chassisMass + sum(engine.mass) + sum(core.mass) + sum(trailer.mass) + sum(addon.mass) + sum(cargo.mass) + skarnit",
    "max_mass": "sum(engine.thrust) + sum(addon.thrust)",
    "load": "mass / max_mass  (must be <= 1)",
    "power_draw": "cabPowerDraw + sum(engine.powerDraw) + sum(addon.powerDraw) + sum(trailer.powerDraw)",
    "power_rule": "power_draw <= sum(core.powerOutput)",
    "mobility": "clamp(round_half_up(baseMobility * (1 - load^2) + sum(addon.mobility) - trailerMobilityPenalty * trailerCount), 0, 100)",
    "delta_v": "round_half_up(engine.efficiency * skarnit / mass)",
    "endurance": "round_half_up(skarnit / sum(core.skarnitPerDay))",
    "pilot_modifier": "floor((mobility - 50) / 10)"
  },
  "constants": {
    "trailer_mobility_penalty": 5,
    "warn_load": 0.85,
    "warn_power": 0.9,
    "warn_mobility": 19,
