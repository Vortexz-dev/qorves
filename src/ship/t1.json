    "endurance": "gün",
    "skarnit": "t"
  },
  "glossary": [
    {
      "stat": "Mass",
      "unit": "t",
      "definition_tr": "Geminin toplam kütlesi: şasi, motor, çekirdek, dorseler, eklentiler, yük ve Skarnit."
    },
    {
      "stat": "Max Mass",
      "unit": "t",
      "definition_tr": "Geminin hareket ettirebileceği en büyük kütle; toplam Thrust'a eşittir."
    },
    {
      "stat": "Load",
      "unit": "%",
      "definition_tr": "Mass'in Max Mass'e oranı. %100'ü geçemez."
    },
    {
      "stat": "Thrust",
      "unit": "t",
      "definition_tr": "İtki. 1 Thrust, 1 ton kütleyi taşır. Skarn Motoru ve itici eklentilerinden gelir."
    },
    {
      "stat": "Power Output",
      "unit": "—",
      "definition_tr": "Skarn Çekirdeği'nin (ya da insan reaktörünün) ürettiği güç."
    },
    {
      "stat": "Power Draw",
      "unit": "—",
      "definition_tr": "Takılı her şeyin çektiği güç toplamı. Power Output'u geçemez."
    },
    {
      "stat": "Mobility",
      "unit": "0–100",
      "definition_tr": "Manevra kabiliyeti. Load arttıkça düşer; itici eklentileri artırır."
    },
    {
      "stat": "Delta-V",
      "unit": "sayı",
      "definition_tr": "Yakıtla yapılabilecek toplam hız değişimi göstergesi. Ağır gemide düşer."
    },
    {
      "stat": "Endurance",
      "unit": "gün",
      "definition_tr": "Çekirdeğin mevcut Skarnit ile kaç gün güç üretebileceği."
    },
    {
      "stat": "Skarnit",
      "unit": "t",
      "definition_tr": "Hem motorun hem çekirdeğin yakıtı. Kütleye sayılır."
    },
    {
      "stat": "Capacity",
      "unit": "t",
      "definition_tr": "Bir ambarın taşıyabileceği yük. Hidden Capacity: taramada görünmeyen yük."
    },
    {
      "stat": "Armor",
      "unit": "sayı",
      "definition_tr": "Gövde dayanıklılığı; darbeyi azaltır."
    },
    {
      "stat": "Shield",
      "unit": "sayı",
      "definition_tr": "Kalkan puanı; Regen, her tur geri dolan miktar."
    },
    {
      "stat": "Damage / Range",
      "unit": "sayı / Kısa–Orta–Uzun",
      "definition_tr": "Silahın verdiği hasar ve menzili."
    },
    {
      "stat": "Slot",
      "unit": "S1–S3",
      "definition_tr": "Eklenti yuvası. Boyutu (S1 küçük, S2 orta, S3 büyük) ve yeri (Dış ya da İç) vardır."
    },
    {
      "stat": "Tier",
      "unit": "T1–T4",
      "definition_tr": "Şasi kademesi. Dorse boyutu da aynı kodla yazılır ve hangi şasiye bağlanacağını gösterir."
    },
    {
      "stat": "Legality",
      "unit": "Yasal / Lisanslı / Gri / Kaçak",
      "definition_tr": "Parçanın yasal durumu; denetim ve liman kurallarını etkiler."
    }
  ],
  "size_rules": {
    "hull_sizes": [
      "T1",
      "T2",
