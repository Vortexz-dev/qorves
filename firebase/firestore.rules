rules_version = '2';
// QORVES — Firestore güvenlik kuralları.
// Oyuncu yalnız kendi profilini, notlarını ve dosyalarını okur/yazar.
// DM (users/{uid}.role == 'dm'; kendi kendine atanamaz) her şeyi okur. Bilgi kilitleri (grants, vault, world) yalnız DM yazar.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function isDM() {
      return signedIn() && exists(/databases/$(db)/documents/users/$(request.auth.uid))
        && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role == 'dm';
    }
    // DM rolü yalnız önceden belirlenmiş DM hesabının ilk kaydında kabul edilir.
    function dmEmail() { return 'dungeonmaster@qorves-sistem.firebaseapp.com'; }

    match /users/{uid} {
      allow read: if isMe(uid) || isDM();
      allow create: if isMe(uid) && request.resource.data.uid == uid && (
        request.resource.data.role == 'player' ||
        (request.resource.data.role == 'dm' && request.auth.token.email == dmEmail()));
      allow update: if isDM() || (isMe(uid) && request.resource.data.role == resource.data.role
                        && request.resource.data.uid == resource.data.uid
                        && request.resource.data.get('lockedApps', []) == resource.data.get('lockedApps', []));
      allow delete: if isDM();

      match /notes/{noteId} {
        allow read: if isMe(uid) || isDM();
        allow write: if isMe(uid) && (request.resource == null || request.resource.data.size() < 40);
        allow delete: if isDM();
      }
      // Masaüstü klasörleri ve kaydedilmiş görseller: yalnız ad + adres (veri yok).
      match /items/{itemId} {
        allow read: if isMe(uid) || isDM();
        allow delete: if isMe(uid) || isDM();
        allow create, update: if (isMe(uid) || isDM()) && request.resource.data.size() < 14
          && request.resource.data.kind in ['folder', 'image', 'doc']
          && (!('body' in request.resource.data) || (request.resource.data.body is string && request.resource.data.body.size() < 20000))
          && request.resource.data.name is string && request.resource.data.name.size() <= 80
          && (!('src' in request.resource.data) || (request.resource.data.src is string && request.resource.data.src.size() < 600));
      }
      // Seyir Defteri: oturum başlığı + sayfalar. Yalnız sahibi yazar; sahibi ve DM okur.
      match /logs/{sid} {
        allow read: if isMe(uid) || isDM();
        allow delete: if isMe(uid);
        allow create, update: if isMe(uid) && request.resource.data.keys().hasOnly(['n', 'sub', 'at', 'pages'])
          && request.resource.data.n is int && request.resource.data.n > 0
          && request.resource.data.sub is string && request.resource.data.sub.size() <= 80
          && request.resource.data.pages is list && request.resource.data.pages.size() <= 500;
        match /p/{pid} {
          allow read: if isMe(uid) || isDM();
          allow delete: if isMe(uid);
          allow create, update: if isMe(uid) && request.resource.data.keys().hasOnly(['h', 'at'])
            && request.resource.data.h is string && request.resource.data.h.size() <= 300000;
        }
      }
      // DM'den gelen sistem bildirimleri: oyuncu okur, yalnız "görüldü" işaretler.
      match /notify/{nid} {
        allow read: if isMe(uid) || isDM();
        allow create, delete: if isDM();
        allow update: if isMe(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen']);
      }
      // Tek tek açılan Kodeks kayıtları (DM düz metni oyuncuya kopyalar).
      match /reveals/{rid} {
        allow read: if isMe(uid) || isDM();
        allow write: if isDM();
      }
      // DM'in oyuncu masaüstüne bıraktığı görseller (veri adresi).
      match /media/{mid} {
        allow read: if isMe(uid) || isDM();
        allow write: if isDM() && (request.resource == null || (request.resource.data.d is string && request.resource.data.d.size() < 950000));
        // God's Eye ekran görüntüsü: oyuncu kendi görselini oluşturur (yalnız d + at)
        allow create: if isMe(uid) && request.resource.data.keys().hasOnly(['d', 'at']) && request.resource.data.d is string && request.resource.data.d.size() < 950000;
        allow delete: if isMe(uid);
      }
      match /files/{fileId} {
        allow read: if isMe(uid) || isDM();
        allow write: if isMe(uid);
        allow delete: if isDM();
        match /chunks/{n} {
          allow read: if isMe(uid) || isDM();
          allow write: if isMe(uid) && (request.resource == null || request.resource.data.d.size() < 900000);
          allow delete: if isDM();
        }
      }
    }
    // Oyuncu başına açık bilgi anahtarları: oyuncu kendininkini okur, yalnız DM yazar.
    match /grants/{uid} {
      allow read: if isMe(uid) || isDM();
      allow write: if isDM();
    }
    // Kilitli bilgi paketlerinin anahtarları (Faz 2).
    match /vault/{keyId} {
      allow read: if isDM() || (signedIn() && request.auth.uid in resource.data.readers);
      allow write: if isDM();
    }
    // Oyun günü, olaylar: herkes okur, DM yazar.
    match /world/{docId} {
      allow read: if signedIn();
      allow write: if isDM();
    }
    // Oyuncu, kendisine gönderilen sızma saldırısının sonucunu işaretleyebilir.
    match /world/hackatk {
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done', 'ok', 'at']);
    }
    // Çevrimiçi durumu: herkes okur (kişi listesi), herkes yalnız kendini yazar.
    match /presence/{uid} {
      allow read: if signedIn();
      allow write: if isMe(uid) && request.resource.data.uid == uid && request.resource.data.size() < 10;
      allow delete: if isDM();
    }
    // ghOS-Net: NPC kimlikleri yalnız DM yazar.
    match /npcs/{id} {
      allow read: if signedIn();
      allow write: if isDM();
    }
    // ghOS-Net konuşmaları: yalnız üyeler (ve DM). Üyeler değiştirilemez.
    match /convs/{cid} {
      function member() { return signedIn() && request.auth.uid in resource.data.members; }
      allow read: if isDM() || member();
      allow create: if isDM() || (signedIn() && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2 && !(request.resource.data.npc is string));
      allow update: if isDM() || (member() && request.resource.data.members == resource.data.members
        && request.resource.data.get('npc', null) == resource.data.get('npc', null));
      allow delete: if isDM();
      match /m/{mid} {
        function inConv() { return signedIn() && request.auth.uid in get(/databases/$(db)/documents/convs/$(cid)).data.members; }
        allow read: if isDM() || inConv();
        allow create: if isDM() || (inConv() && request.resource.data.from == request.auth.uid && request.resource.data.text is string && request.resource.data.text.size() <= 2000);
        allow update, delete: if isDM();
      }
    }
    // Cüzdan: oyuncu okur, DM yazar. Oyuncular arası aktarım tek bir toplu yazımla olur:
    // transfers/{tid} + gönderen cüzdanı (lt = tid, bakiye - tutar) + alıcı cüzdanı (ri = tid, bakiye + tutar)
    // + iki tarafın tx/{tid} kaydı. Kurallar her parçayı getAfter ile birbirine bağlar; biri eksikse hepsi reddedilir.
    function trPath(t) { return /databases/$(db)/documents/transfers/$(t); }
    function wPath(u) { return /databases/$(db)/documents/wallet/$(u); }
    function walletByTransfer(uid) {
      let side = isMe(uid) ? 'lt' : 'ri';
      let tid = request.resource.data.get(side, '');
      let t = getAfter(trPath(tid)).data;
      let old = resource == null ? 0 : resource.data.bal.get(t.cur, 0);
      let nb = request.resource.data.bal.get(t.cur, -1);
      return tid is string && tid.size() > 0 && !exists(trPath(tid))
        && t.from == request.auth.uid
        && ((isMe(uid) && t.from == uid && nb == old - t.amt) || (!isMe(uid) && t.to == uid && nb == old + t.amt))
        && nb >= 0
        && (resource == null
          ? request.resource.data.keys().hasOnly(['bal', 'at', side]) && request.resource.data.bal.keys().hasOnly([t.cur])
          : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bal', 'at', side])
            && request.resource.data.bal.diff(resource.data.bal).affectedKeys().hasOnly([t.cur]));
    }
    match /wallet/{uid} {
      allow read: if isMe(uid) || isDM();
      allow write: if isDM();
      allow create, update: if signedIn() && walletByTransfer(uid);
      allow update: if isMe(uid) && walletByDuel(uid);
      allow update: if isMe(uid) && walletByClash(uid);
      match /tx/{tid} {
        allow read: if isMe(uid) || isDM();
        allow write: if isDM();
        allow create: if signedIn() && !exists(trPath(tid)) && txByTransfer(uid, tid);
        allow create: if isMe(uid) && txByDuel(uid, tid);
        allow create: if isMe(uid) && txByClash(uid, tid);
      }
    }
    function txByTransfer(uid, tid) {
      let t = getAfter(trPath(tid)).data;
      let d = request.resource.data;
      return t.from == request.auth.uid && (uid == t.from || uid == t.to)
        && d.keys().hasOnly(['cur', 'amt', 'reason', 'at', 'bal', 'tr', 'peer'])
        && d.cur == t.cur && d.amt == (uid == t.from ? -t.amt : t.amt) && d.tr == tid
        && d.reason is string && d.reason.size() <= 200 && d.at == t.at
        && (uid == t.from ? d.bal == getAfter(wPath(uid)).data.bal[t.cur] : !('bal' in d));
    }
    // Zar Düellosu: oyuncu bota karşı BK ile oynar. Oyun kaydı + cüzdan + tx tek işlemde; kurallar hepsini birbirine bağlar.
    // Sonuç zarlardan hesaplanır: yüksek toplam kazanır; eşitlikte iade, ikisi de 7 ise bot kazanır. Bahis 10–500 BK.
    function gPath(g) { return /databases/$(db)/documents/games/$(g); }
    function die(v) { return v is int && v >= 1 && v <= 6; }
    function walletByDuel(uid) {
      let gid = request.resource.data.get('lg', '');
      let g = getAfter(gPath(gid)).data;
      let old = resource.data.bal.get('BK', 0);
      return gid is string && gid.size() > 0 && !exists(gPath(gid)) && g.uid == uid && g.delta != 0
        && request.resource.data.bal.get('BK', -1) == old + g.delta && old + g.delta >= 0 && g.bal == old + g.delta
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bal', 'at', 'lg'])
        && request.resource.data.bal.diff(resource.data.bal).affectedKeys().hasOnly(['BK']);
    }
    // CROWN CLASH QORE alımı: cüzdandan BK düşer (lq = alım kimliği); clash_buys kaydına bağlı.
    function walletByClash(uid) {
      let bid = request.resource.data.get('lq', '');
      let b = getAfter(/databases/$(db)/documents/clash_buys/$(bid)).data;
      let old = resource.data.bal.get('BK', 0);
      return bid is string && bid.size() > 0 && !exists(/databases/$(db)/documents/clash_buys/$(bid)) && b.uid == uid
        && request.resource.data.bal.get('BK', -1) == old - b.bk && old - b.bk >= 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bal', 'at', 'lq'])
        && request.resource.data.bal.diff(resource.data.bal).affectedKeys().hasOnly(['BK']);
    }
    function txByClash(uid, tid) {
      let b = getAfter(/databases/$(db)/documents/clash_buys/$(tid)).data;
      let d = request.resource.data;
      return !exists(/databases/$(db)/documents/clash_buys/$(tid)) && b.uid == uid
        && d.keys().hasOnly(['cur', 'amt', 'reason', 'at', 'bal', 'q'])
        && d.cur == 'BK' && d.amt == -b.bk && d.q == tid && d.at == b.at && d.bal == b.bal
        && d.reason is string && d.reason.size() <= 200;
    }
    function txByDuel(uid, tid) {
      let g = getAfter(gPath(tid)).data;
      let d = request.resource.data;
      return !exists(gPath(tid)) && g.uid == uid && d.keys().hasOnly(['cur', 'amt', 'reason', 'at', 'bal', 'g'])
        && d.cur == 'BK' && d.amt == g.delta && d.g == tid && d.at == g.at && d.bal == g.bal
        && d.reason is string && d.reason.size() <= 200;
    }
    function duelOk(gid) {
      let d = request.resource.data;
      let ps = d.p[0] + d.p[1];
      let bs = d.b[0] + d.b[1];
      let w = get(wPath(request.auth.uid)).data.bal.get('BK', 0);
      return d.keys().hasOnly(['uid', 'name', 'cur', 'bet', 'p', 'b', 'res', 'delta', 'at', 'bal'])
        && d.uid == request.auth.uid && d.cur == 'BK' && d.name is string && d.name.size() <= 60
        && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role == 'player'
        && d.bet is int && d.bet >= 10 && d.bet <= 500 && w >= d.bet
        && d.p is list && d.p.size() == 2 && die(d.p[0]) && die(d.p[1])
        && d.b is list && d.b.size() == 2 && die(d.b[0]) && die(d.b[1])
        && ((ps > bs && d.res == 'win' && d.delta == d.bet)
          || ((ps < bs || (ps == bs && ps == 7)) && d.res == 'lose' && d.delta == -d.bet)
          || (ps == bs && ps != 7 && d.res == 'push' && d.delta == 0))
        && d.at is number && d.at > request.time.toMillis() - 600000 && d.at < request.time.toMillis() + 600000
        && (d.delta == 0
          ? d.bal == w
          : (getAfter(wPath(request.auth.uid)).data.get('lg', '') == gid && getAfter(wPath(request.auth.uid)).data.bal.BK == w + d.delta
             && d.bal == w + d.delta && existsAfter(/databases/$(db)/documents/wallet/$(request.auth.uid)/tx/$(gid))));
    }
    match /games/{gid} {
      allow read: if isDM() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && duelOk(gid);
      allow update, delete: if isDM();
    }
    // Aktarım kayıtları: değiştirilemez; taraflar ve DM okur.
    match /transfers/{tid} {
      allow read: if isDM() || (signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid));
      allow update, delete: if isDM();
      allow create: if signedIn() && transferOk(tid);
    }
    function transferOk(tid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['from', 'to', 'cur', 'amt', 'at', 'note', 'fromName', 'toName'])
        && d.keys().hasAll(['from', 'to', 'cur', 'amt', 'at'])
        && d.from == request.auth.uid && d.to is string && d.to != d.from
        && d.cur in ['BK', 'Mark', 'Kantar'] && d.amt is number && d.amt > 0 && d.amt <= 1000000000
        && d.at is number && d.at > request.time.toMillis() - 600000 && d.at < request.time.toMillis() + 600000
        && (!('note' in d) || (d.note is string && d.note.size() <= 140))
        && (!('fromName' in d) || (d.fromName is string && d.fromName.size() <= 60))
        && (!('toName' in d) || (d.toName is string && d.toName.size() <= 60))
        && get(/databases/$(db)/documents/users/$(d.to)).data.role == 'player'
        && get(/databases/$(db)/documents/users/$(d.from)).data.role == 'player'
        && getAfter(wPath(d.from)).data.get('lt', '') == tid
        && getAfter(wPath(d.to)).data.get('ri', '') == tid
        && existsAfter(/databases/$(db)/documents/wallet/$(d.from)/tx/$(tid))
        && existsAfter(/databases/$(db)/documents/wallet/$(d.to)/tx/$(tid));
    }
    // Zar atışları: oyuncu kendi atışını yazar; DM hepsini görür.
    match /rolls/{rid} {
      allow read: if isDM() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.size() < 20;
      allow update, delete: if isDM();
    }
    // Yıldız haritası işaretleri: seçilen oyuncular görür.
    match /markers/{id} {
      allow read: if isDM() || (signedIn() && request.auth.uid in resource.data.players);
      allow write: if isDM();
    }
    // Starmap oyuncu notları: 'pub' herkes, 'priv' yalnız yazan + DM. Yalnız kendi notunu yazar/düzenler; DM her notu silebilir.
    function noteOk(d) {
      return d.keys().hasOnly(['id', 'uid', 'by', 'sys', 'body', 'x', 'y', 'z', 'icon', 'col', 'label', 'text', 'vis', 'at', 'upd'])
        && d.keys().hasAll(['id', 'uid', 'by', 'sys', 'icon', 'col', 'label', 'text', 'vis', 'at', 'upd'])
        && d.uid == request.auth.uid
        && d.by is string && d.by.size() > 0 && d.by.size() <= 48
        && d.sys is string && d.sys.size() > 0 && d.sys.size() <= 64
        && (!('body' in d) || (d.body is string && d.body.size() <= 80))
        && (!('x' in d) || d.x is number) && (!('y' in d) || d.y is number) && (!('z' in d) || d.z is number)
        && d.icon in ['pin', 'note', 'flag', 'eye', 'skull', 'cache']
        && d.col is string && d.col.matches('^#[0-9a-fA-F]{6}$')
        && d.label is string && d.label.size() > 0 && d.label.size() <= 60
        && d.text is string && d.text.size() <= 600
        && d.vis in ['pub', 'priv']
        && d.at is number && d.upd is number;
    }
    match /mapnotes/{id} {
      allow read: if isDM() || (signedIn() && (resource.data.vis == 'pub' || resource.data.uid == request.auth.uid));
      allow create: if signedIn() && request.resource.data.id == id && noteOk(request.resource.data);
      allow update: if signedIn() && resource.data.uid == request.auth.uid && request.resource.data.id == id
        && request.resource.data.at == resource.data.at && noteOk(request.resource.data);
      allow delete: if isDM() || (signedIn() && resource.data.uid == request.auth.uid);
    }
    // DM'in eklediği Timeline olayları: yayımlanınca herkes görür.
    match /tlevents/{id} {
      allow read: if isDM() || (signedIn() && resource.data.published == true);
      allow write: if isDM();
    }
    // Site ayarları (ör. zar kanalı adresi): giriş yapan okur, DM yazar.
    // ---------- God's Eye ----------
    // DM her şeyi yazar. Oyuncu yalnız atandığı sahneyi okur; yalnız kendi jetonunu/işaretini (o sahnede) ve kendi kayıtlarını yazar.
    function geSid() { return get(/databases/$(db)/documents/ge_asg/main).data.map.get(request.auth.uid, ''); }
    function geMine(id) { return signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.sid is string
      && request.resource.data.sid != '' && request.resource.data.sid == geSid() && id == request.resource.data.sid + '_' + request.auth.uid; }
    match /ge_asg/{id} { allow read: if signedIn(); allow write: if isDM(); }
    match /ge_dep/{id} { allow read, write: if isDM(); }
    match /ge_scn/{sid} { allow read: if isDM() || (signedIn() && geSid() == sid); allow write: if isDM(); }
    match /ge_ink/{lid} { allow read: if isDM() || (signedIn() && resource.data.sid == geSid()); allow write: if isDM(); }
    match /ge_blob/{bid} {
      allow read: if isDM() || (signedIn() && geSid() != '' && resource.data.img in get(/databases/$(db)/documents/ge_scn/$(geSid())).data.imgs);
      allow write: if isDM();
    }
    match /ge_tok/{id} {
      allow read: if isDM() || (signedIn() && resource.data.sid == geSid());
      allow create, update: if isDM() || (geMine(id) && request.resource.data.keys().hasOnly(['sid', 'uid', 'name', 'img', 'col', 'x', 'y', 'at'])
        && request.resource.data.img is string && request.resource.data.img.size() < 60000 && request.resource.data.x is number && request.resource.data.y is number);
      allow delete: if isDM() || (signedIn() && resource.data.uid == request.auth.uid);
    }
    // cetvel: sahneye özel, geçici (ölçerken ~6 Hz yazılır, bırakınca silinir)
    match /ge_rul/{id} {
      allow read: if isDM() || (signedIn() && resource.data.sid == geSid());
      allow create, update: if isDM() || (geMine(id) && request.resource.data.keys().hasOnly(['sid', 'uid', 'name', 'col', 'a', 'b', 'd', 'at'])
        && request.resource.data.a is list && request.resource.data.b is list && request.resource.data.d is string && request.resource.data.d.size() < 40);
      allow delete: if isDM() || (signedIn() && resource.data.uid == request.auth.uid);
    }
    // ortak sohbet: bütün sahnelerde tek akış (mesaj + zar atışı özeti)
    match /ge_chat/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.keys().hasOnly(['uid', 'name', 'col', 'k', 't', 'at', 'nat'])
        && request.resource.data.t is string && request.resource.data.t.size() > 0 && request.resource.data.t.size() <= 400 && request.resource.data.k in ['msg', 'roll'];
      allow delete: if isDM();
    }
    match /ge_ping/{id} {
      allow read: if isDM() || (signedIn() && resource.data.sid == geSid());
      allow create, update: if isDM() || (geMine(id) && request.resource.data.keys().hasOnly(['sid', 'uid', 'name', 'col', 'x', 'y', 'at']));
      allow delete: if isDM();
    }
    match /ge_log/{id} {
      allow read, delete: if isDM();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.id == id
        && request.resource.data.kind in ['note', 'shot', 'ping'] && request.resource.data.keys().hasOnly(['id', 'uid', 'name', 'kind', 'title', 'body', 'sid', 'scene', 'src', 'thumb', 'at'])
        && (!('body' in request.resource.data) || request.resource.data.body.size() <= 20000) && (!('thumb' in request.resource.data) || request.resource.data.thumb.size() < 120000);
    }
    // ---------- Gemi (Docked & Loaded): tek ortak doküman, herkes düzenler (sürüm sayacı + işlem), DM her şeyi ----------
    match /ship/{id} {
      allow read: if signedIn();
      allow create: if isDM() || (signedIn() && id == 'main' && request.resource.data.rev == 1);
      allow update: if isDM() || (signedIn() && id == 'main' && request.resource.data.rev == resource.data.rev + 1 && request.resource.data.by == request.auth.uid
        && request.resource.data.keys().hasOnly(['rev', 'at', 'by', 'name', 'chassis', 'engine', 'core', 'skarnit', 'fit', 'trailers', 'inv', 'cargo'])
        && request.resource.data.name == resource.data.name && request.resource.data.chassis == resource.data.chassis && request.resource.data.skarnit == resource.data.skarnit
        && request.resource.data.fit is map && request.resource.data.inv is map && request.resource.data.trailers is list && request.resource.data.trailers.size() <= 5 && request.resource.data.cargo is list);
      allow delete: if isDM();
    }
    match /ship_log/{id} {
      allow read, delete: if isDM();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.keys().hasOnly(['uid', 'name', 'op', 'text', 'at']) && request.resource.data.text is string && request.resource.data.text.size() <= 300;
    }
    match /ship_tok/{uid} {
      allow read: if signedIn();
      allow create, update: if isDM() || (signedIn() && uid == request.auth.uid && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'img', 'col', 'x', 'y', 'f', 'at']) && request.resource.data.img is string && request.resource.data.img.size() < 60000
        && request.resource.data.x is number && request.resource.data.y is number && request.resource.data.f is number);
      allow delete: if isDM() || (signedIn() && uid == request.auth.uid);
    }

    // Persona.ID: kağıt + envanter (oyuncu), krom (DM).
    match /persona/{uid} {
      allow read: if isMe(uid) || isDM();
      allow create: if isMe(uid) || isDM();
      allow update: if isDM() || (isMe(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hp', 'unspent', 'lvlSeen', 'armor', 'at']));
      allow delete: if isDM();
      match /inv/{id} {
        allow read: if isMe(uid) || isDM();
        allow delete: if isMe(uid) || isDM();
        allow create, update: if (isMe(uid) || isDM()) && request.resource.data.name is string && request.resource.data.name.size() <= 80
          && request.resource.data.kg is number && request.resource.data.qty is int
          && (!('img' in request.resource.data) || (request.resource.data.img is string && request.resource.data.img.size() < 120000))
          && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 400));
      }
      match /chrome/{id} {
        allow read: if isMe(uid) || isDM();
        allow write: if isDM();
      }
    }
    // Günlük: görevler, ödüller, NPC ilişkileri — görünür oyuncular okur, DM yazar.
    match /journal/{id} {
      allow read: if isDM() || (signedIn() && request.auth.uid in resource.data.players);
      allow write: if isDM();
    }
    match /bounties/{id} {
      allow read: if isDM() || (signedIn() && request.auth.uid in resource.data.players);
      allow write: if isDM();
    }
    match /rels/{id} {
      allow read: if isDM() || (signedIn() && request.auth.uid in resource.data.players);
      allow write: if isDM();
    }
    // Qorves Times: DM haberi. Harita olayları istemcide türetilir.
    match /news/{id} {
      allow read: if signedIn();
      allow write: if isDM();
    }
    // ghOS-Key ağları ve log.
    match /hacknet/{id} {
      allow read: if isDM() || (signedIn() && request.auth.uid in resource.data.players);
      allow write: if isDM();
    }
    match /hacklog/{id} {
      allow read: if isDM() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isDM();
    }
    // DM radyosu MP3 parçaları (Spark: Storage yok).
    match /radio_files/{id} {
      allow read: if signedIn();
      allow write: if isDM();
      match /chunks/{n} {
        allow read: if signedIn();
        allow write: if isDM() && (request.resource == null || (request.resource.data.d is string && request.resource.data.d.size() < 900000));
      }
    }

    // CROWN CLASH — profil/envanter, ortak sıralama (oyuncu + kalıcı bot), arkadaş/düello, QORE satın alma ve komut kilit-adımı.
    // Spark: maç başına ~50–120 komut yazması; maç sonu 2–3 yazma. Sandık RNG'si istemcide; kurallar artışları sınırlar.
    function invPath(u) { return /databases/$(db)/documents/clash_inv/$(u); }
    function buyPath(b) { return /databases/$(db)/documents/clash_buys/$(b); }
    function invKeys(d) {
      return d.keys().hasOnly(['bit', 'qore', 'cards', 'chests', 'deck', 'cr', 'best', 'w', 'l', 'd', 'streak', 'at', 'lb'])
        && d.bit is int && d.bit >= 0 && d.qore is int && d.qore >= 0 && d.cards is map && d.chests is list && d.chests.size() <= 4
        && d.deck is list && d.deck.size() == 8 && d.cr is int && d.cr >= 0 && d.w is int && d.l is int && d.d is int;
    }
    match /clash_inv/{uid} {
      allow read: if isMe(uid) || isDM();
      allow create: if isMe(uid) && invKeys(request.resource.data) && request.resource.data.qore == 0 && request.resource.data.bit <= 600
        && request.resource.data.cr <= 1500 && request.resource.data.w == 0 && !('lb' in request.resource.data);
      // olağan kayıt: QORE yalnız harcanır; BIT artışı sınırlı (+QORE ile alınan BIT paketi); kupa maç başına en çok ±60.
      allow update: if isMe(uid) && invKeys(request.resource.data)
        && request.resource.data.qore <= resource.data.qore
        && request.resource.data.bit - resource.data.bit <= 2400 + (resource.data.qore - request.resource.data.qore) * 23
        && request.resource.data.cr - resource.data.cr <= 60 && resource.data.cr - request.resource.data.cr <= 60
        && request.resource.data.w - resource.data.w <= 1 && request.resource.data.w >= resource.data.w
        && request.resource.data.get('lb', '') == resource.data.get('lb', '');
      // satın alma: yalnız qore + lb değişir; aynı toplu yazımdaki clash_buys kaydına bağlı.
      allow update: if isMe(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qore', 'lb', 'at'])
        && request.resource.data.lb is string && !exists(buyPath(request.resource.data.lb))
        && getAfter(buyPath(request.resource.data.lb)).data.uid == uid
        && request.resource.data.qore == resource.data.qore + getAfter(buyPath(request.resource.data.lb)).data.qore;
      allow delete: if isDM();
    }
    function packOk(d) {
      return (d.pack == 'p1' && d.qore == 100 && d.bk == 500) || (d.pack == 'p2' && d.qore == 550 && d.bk == 2500) || (d.pack == 'p3' && d.qore == 1200 && d.bk == 5000);
    }
    match /clash_buys/{bid} {
      allow read: if isDM() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['uid', 'name', 'pack', 'qore', 'bk', 'at', 'bal'])
        && request.resource.data.uid == request.auth.uid && packOk(request.resource.data)
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role == 'player'
        && request.resource.data.at is int && request.resource.data.at > request.time.toMillis() - 600000 && request.resource.data.at < request.time.toMillis() + 600000
        && getAfter(wPath(request.auth.uid)).data.get('lq', '') == bid
        && request.resource.data.bal == get(wPath(request.auth.uid)).data.bal.get('BK', 0) - request.resource.data.bk
        && getAfter(wPath(request.auth.uid)).data.bal.BK == request.resource.data.bal && request.resource.data.bal >= 0
        && existsAfter(/databases/$(db)/documents/wallet/$(request.auth.uid)/tx/$(bid))
        && getAfter(invPath(request.auth.uid)).data.get('lb', '') == bid;
      allow update, delete: if isDM();
    }
    match /clash_decks/{uid} {
      allow read: if signedIn();
      allow write: if isMe(uid) && request.resource.data.keys().hasOnly(['uid', 'name', 'cr', 'best', 'w', 'l', 'd', 'deck', 'dl', 'lv', 'at'])
        && request.resource.data.deck is list && request.resource.data.deck.size() == 8 && request.resource.data.dl is list && request.resource.data.dl.size() == 8
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.cr == getAfter(invPath(uid)).data.cr;
      allow delete: if isDM();
    }
    match /clash_bots/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && id.matches('b[0-9]{2}') && request.resource.data.keys().hasOnly(['name', 'cr', 'best', 'w', 'l', 'd', 'deck', 'dl', 'lv', 'bot', 'at'])
        && request.resource.data.cr is int && request.resource.data.cr <= 3300 && request.resource.data.w == 0 && request.resource.data.l == 0
        && request.resource.data.deck is list && request.resource.data.deck.size() == 8;
      allow update: if signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cr', 'best', 'w', 'l', 'lv', 'dl', 'at'])
        && request.resource.data.cr is int && request.resource.data.cr >= 0
        && request.resource.data.cr - resource.data.cr <= 60 && resource.data.cr - request.resource.data.cr <= 60
        && request.resource.data.w - resource.data.w <= 1 && request.resource.data.w >= resource.data.w
        && request.resource.data.l - resource.data.l <= 1 && request.resource.data.l >= resource.data.l
        && request.resource.data.lv is int && request.resource.data.lv >= 1 && request.resource.data.lv <= 9
        && request.resource.data.dl is list && request.resource.data.dl.size() == 8;
      allow delete: if isDM();
    }
    // Arka plan bot maçları: tüm oyuncular arasında en fazla 10 dakikada bir.
    match /clash_meta/{id} {
      allow read: if signedIn();
      allow write: if signedIn() && id == 'sim' && request.resource.data.keys().hasOnly(['at', 'n']) && request.resource.data.at == request.time
        && (resource == null || request.time > resource.data.at + duration.value(10, 'm'));
    }
    // Arkadaşlar: kendi belgen serbest; başkasının belgesine yalnız kendini istek olarak ekle, isteği kabul edince kendini arkadaş ekle, ya da kendini çıkar.
    match /clash_fr/{uid} {
      allow read: if signedIn();
      allow write: if isMe(uid) && request.resource.data.keys().hasOnly(['f', 'in', 'name'])
        && request.resource.data.f is list && request.resource.data.f.size() <= 100 && request.resource.data.in is list && request.resource.data.in.size() <= 100;
      allow create, update: if signedIn() && !isMe(uid) && frOther(uid);
    }
    function frOther(uid) {
      let me = request.auth.uid;
      let of = resource == null ? [] : resource.data.f;
      let oi = resource == null ? [] : resource.data.get('in', []);
      let nf = request.resource.data.f;
      let ni = request.resource.data.in;
      return request.resource.data.keys().hasOnly(['f', 'in', 'name']) && nf is list && ni is list
        && (resource == null || request.resource.data.name == resource.data.name)
        && (
          (nf.toSet() == of.toSet() && ni.toSet().difference(oi.toSet()).hasOnly([me]) && oi.toSet().difference(ni.toSet()).size() == 0 && ni.size() <= 100)
          || (ni.toSet() == oi.toSet() && uid in get(/databases/$(db)/documents/clash_fr/$(me)).data.get('in', [])
              && nf.toSet().difference(of.toSet()).hasOnly([me]) && of.toSet().difference(nf.toSet()).size() == 0)
          || (ni.toSet() == oi.toSet() && nf.toSet() == of.toSet().difference([me].toSet()))
        );
    }
    // Düello davetleri: davet eden yazar; davet edilen kabul/ret eder.
    match /clash_duels/{id} {
      allow read: if signedIn() && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
      allow create: if signedIn() && request.resource.data.from == request.auth.uid && request.resource.data.st == 'open'
        && request.resource.data.keys().hasOnly(['from', 'to', 'fromName', 'toName', 'deck', 'cr', 'st', 'at'])
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid && request.resource.data.deck is list && request.resource.data.deck.size() == 8;
      allow update: if signedIn() && (
        (request.auth.uid == resource.data.to && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st', 'match']) && request.resource.data.st in ['ok', 'no'])
        || (request.auth.uid == resource.data.from && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st']) && request.resource.data.st == 'gone'));
      allow delete: if isDM() || (signedIn() && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to));
    }
    match /clash_queue/{uid} {
      allow read: if signedIn();
      allow create, delete: if isMe(uid);
      allow update: if isMe(uid) || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['match']));
    }
    match /clash_matches/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.players;
      allow create: if signedIn() && request.resource.data.players is list && request.resource.data.players.size() == 2 && request.auth.uid in request.resource.data.players;
      allow update: if signedIn() && request.auth.uid in resource.data.players && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['res', 'left']);
      allow delete: if isDM();
      match /cmds/{c} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(db)/documents/clash_matches/$(id)).data.players;
        allow create: if signedIn() && request.resource.data.u == request.auth.uid && request.auth.uid in get(/databases/$(db)/documents/clash_matches/$(id)).data.players;
        allow update: if false;
        allow delete: if isDM();
      }
    }

    match /config/{id} {
      allow read: if signedIn();
      allow write: if isDM();
    }
  }
}
