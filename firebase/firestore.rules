rules_version = '2';
// QORVES — Firestore güvenlik kuralları.
// Oyuncu yalnız kendi profilini, notlarını ve dosyalarını okur/yazar.
// DM (users/{uid}.role == 'dm'; kendi kendine atanamaz) her şeyi okur. Bilgi kilitleri (grants, vault, world) yalnız DM yazar.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function isDM() {
      return signedIn() && exists(/databases/$(db)/documents/users/$(request.auth.uid))
        && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role == 'dm';
    }
    // DM rolü yalnız önceden belirlenmiş DM hesabının ilk kaydında kabul edilir.
    function dmEmail() { return 'dungeonmaster@qorves-sistem.firebaseapp.com'; }

    match /users/{uid} {
      allow read: if isMe(uid) || isDM();
      allow create: if isMe(uid) && request.resource.data.uid == uid && (
        request.resource.data.role == 'player' ||
        (request.resource.data.role == 'dm' && request.auth.token.email == dmEmail()));
      allow update: if (isMe(uid) && request.resource.data.role == resource.data.role
                        && request.resource.data.uid == resource.data.uid) || isDM();
      allow delete: if isDM();

      match /notes/{noteId} {
        allow read: if isMe(uid) || isDM();
        allow write: if isMe(uid) && (request.resource == null || request.resource.data.size() < 40);
        allow delete: if isDM();
      }
      // Masaüstü klasörleri ve kaydedilmiş görseller: yalnız ad + adres (veri yok).
      match /items/{itemId} {
        allow read: if isMe(uid) || isDM();
        allow delete: if isMe(uid) || isDM();
        allow create, update: if (isMe(uid) || isDM()) && request.resource.data.size() < 14
          && request.resource.data.kind in ['folder', 'image', 'doc']
          && (!('body' in request.resource.data) || (request.resource.data.body is string && request.resource.data.body.size() < 20000))
          && request.resource.data.name is string && request.resource.data.name.size() <= 80
          && (!('src' in request.resource.data) || (request.resource.data.src is string && request.resource.data.src.size() < 600));
      }
      // DM'den gelen sistem bildirimleri: oyuncu okur, yalnız "görüldü" işaretler.
      match /notify/{nid} {
        allow read: if isMe(uid) || isDM();
        allow create, delete: if isDM();
        allow update: if isMe(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen']);
      }
      // Tek tek açılan Kodeks kayıtları (DM düz metni oyuncuya kopyalar).
      match /reveals/{rid} {
        allow read: if isMe(uid) || isDM();
        allow write: if isDM();
      }
      // DM'in oyuncu masaüstüne bıraktığı görseller (veri adresi).
      match /media/{mid} {
        allow read: if isMe(uid) || isDM();
        allow write: if isDM() && (request.resource == null || (request.resource.data.d is string && request.resource.data.d.size() < 950000));
      }
      match /files/{fileId} {
        allow read: if isMe(uid) || isDM();
        allow write: if isMe(uid);
        allow delete: if isDM();
        match /chunks/{n} {
          allow read: if isMe(uid) || isDM();
          allow write: if isMe(uid) && (request.resource == null || request.resource.data.d.size() < 900000);
          allow delete: if isDM();
        }
      }
    }
    // Oyuncu başına açık bilgi anahtarları: oyuncu kendininkini okur, yalnız DM yazar.
    match /grants/{uid} {
      allow read: if isMe(uid) || isDM();
      allow write: if isDM();
    }
    // Kilitli bilgi paketlerinin anahtarları (Faz 2).
    match /vault/{keyId} {
      allow read: if isDM() || (signedIn() && request.auth.uid in resource.data.readers);
      allow write: if isDM();
    }
    // Oyun günü, olaylar: herkes okur, DM yazar.
    match /world/{docId} {
      allow read: if signedIn();
      allow write: if isDM();
    }
    // Çevrimiçi durumu: herkes okur (kişi listesi), herkes yalnız kendini yazar.
    match /presence/{uid} {
      allow read: if signedIn();
      allow write: if isMe(uid) && request.resource.data.uid == uid && request.resource.data.size() < 10;
      allow delete: if isDM();
    }
    // ghOS-Net: NPC kimlikleri yalnız DM yazar.
    match /npcs/{id} {
      allow read: if signedIn();
      allow write: if isDM();
    }
    // ghOS-Net konuşmaları: yalnız üyeler (ve DM). Üyeler değiştirilemez.
    match /convs/{cid} {
      function member() { return signedIn() && request.auth.uid in resource.data.members; }
      allow read: if isDM() || member();
      allow create: if isDM() || (signedIn() && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2 && !(request.resource.data.npc is string));
      allow update: if isDM() || (member() && request.resource.data.members == resource.data.members
        && request.resource.data.get('npc', null) == resource.data.get('npc', null));
      allow delete: if isDM();
      match /m/{mid} {
        function inConv() { return signedIn() && request.auth.uid in get(/databases/$(db)/documents/convs/$(cid)).data.members; }
        allow read: if isDM() || inConv();
        allow create: if isDM() || (inConv() && request.resource.data.from == request.auth.uid && request.resource.data.text is string && request.resource.data.text.size() <= 2000);
        allow update, delete: if isDM();
      }
    }
    // Cüzdan: oyuncu okur, DM yazar. Oyuncular arası aktarım tek bir toplu yazımla olur:
    // transfers/{tid} + gönderen cüzdanı (lt = tid, bakiye - tutar) + alıcı cüzdanı (ri = tid, bakiye + tutar)
    // + iki tarafın tx/{tid} kaydı. Kurallar her parçayı getAfter ile birbirine bağlar; biri eksikse hepsi reddedilir.
    function trPath(t) { return /databases/$(db)/documents/transfers/$(t); }
    function wPath(u) { return /databases/$(db)/documents/wallet/$(u); }
    function walletByTransfer(uid) {
      let side = isMe(uid) ? 'lt' : 'ri';
      let tid = request.resource.data.get(side, '');
      let t = getAfter(trPath(tid)).data;
      let old = resource == null ? 0 : resource.data.bal.get(t.cur, 0);
      let nb = request.resource.data.bal.get(t.cur, -1);
      return tid is string && tid.size() > 0 && !exists(trPath(tid))
        && t.from == request.auth.uid
        && ((isMe(uid) && t.from == uid && nb == old - t.amt) || (!isMe(uid) && t.to == uid && nb == old + t.amt))
        && nb >= 0
        && (resource == null
          ? request.resource.data.keys().hasOnly(['bal', 'at', side]) && request.resource.data.bal.keys().hasOnly([t.cur])
          : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bal', 'at', side])
            && request.resource.data.bal.diff(resource.data.bal).affectedKeys().hasOnly([t.cur]));
    }
    match /wallet/{uid} {
      allow read: if isMe(uid) || isDM();
      allow write: if isDM();
      allow create, update: if signedIn() && walletByTransfer(uid);
      match /tx/{tid} {
        allow read: if isMe(uid) || isDM();
        allow write: if isDM();
        allow create: if signedIn() && !exists(trPath(tid)) && txByTransfer(uid, tid);
      }
    }
    function txByTransfer(uid, tid) {
      let t = getAfter(trPath(tid)).data;
      let d = request.resource.data;
      return t.from == request.auth.uid && (uid == t.from || uid == t.to)
        && d.keys().hasOnly(['cur', 'amt', 'reason', 'at', 'bal', 'tr', 'peer'])
        && d.cur == t.cur && d.amt == (uid == t.from ? -t.amt : t.amt) && d.tr == tid
        && d.reason is string && d.reason.size() <= 200 && d.at == t.at
        && (uid == t.from ? d.bal == getAfter(wPath(uid)).data.bal[t.cur] : !('bal' in d));
    }
    // Aktarım kayıtları: değiştirilemez; taraflar ve DM okur.
    match /transfers/{tid} {
      allow read: if isDM() || (signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid));
      allow update, delete: if isDM();
      allow create: if signedIn() && transferOk(tid);
    }
    function transferOk(tid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['from', 'to', 'cur', 'amt', 'at', 'note', 'fromName', 'toName'])
        && d.keys().hasAll(['from', 'to', 'cur', 'amt', 'at'])
        && d.from == request.auth.uid && d.to is string && d.to != d.from
        && d.cur in ['BK', 'Mark', 'Kantar'] && d.amt is number && d.amt > 0 && d.amt <= 1000000000
        && d.at is number && d.at > request.time.toMillis() - 600000 && d.at < request.time.toMillis() + 600000
        && (!('note' in d) || (d.note is string && d.note.size() <= 140))
        && (!('fromName' in d) || (d.fromName is string && d.fromName.size() <= 60))
        && (!('toName' in d) || (d.toName is string && d.toName.size() <= 60))
        && get(/databases/$(db)/documents/users/$(d.to)).data.role == 'player'
        && get(/databases/$(db)/documents/users/$(d.from)).data.role == 'player'
        && getAfter(wPath(d.from)).data.get('lt', '') == tid
        && getAfter(wPath(d.to)).data.get('ri', '') == tid
        && existsAfter(/databases/$(db)/documents/wallet/$(d.from)/tx/$(tid))
        && existsAfter(/databases/$(db)/documents/wallet/$(d.to)/tx/$(tid));
    }
    // Zar atışları: oyuncu kendi atışını yazar; DM hepsini görür.
    match /rolls/{rid} {
      allow read: if isDM() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.size() < 20;
      allow update, delete: if isDM();
    }
    // Yıldız haritası işaretleri: seçilen oyuncular görür.
    match /markers/{id} {
      allow read: if isDM() || (signedIn() && request.auth.uid in resource.data.players);
      allow write: if isDM();
    }
    // DM'in eklediği Timeline olayları: yayımlanınca herkes görür.
    match /tlevents/{id} {
      allow read: if isDM() || (signedIn() && resource.data.published == true);
      allow write: if isDM();
    }
    // Site ayarları (ör. zar kanalı adresi): giriş yapan okur, DM yazar.
    match /config/{id} {
      allow read: if signedIn();
      allow write: if isDM();
    }
  }
}
